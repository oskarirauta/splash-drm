# Sample UCI configuration for ubus-progress — install as /etc/config/splash.
#
# It drives the elements created by examples/openwrt-boot.json: a progress bar
# (id 0), a scrolling console (id 0), and a title text (id 99). The JSON
# templates fully control which elements are touched and how, so adapt them to
# your own scene. ${value} is the 0..1 progress fraction; ${service} is the
# name of the service that just started; ${idle} (fail only) is the stall time
# in seconds. An empty/absent template or list is skipped.

# The 'auto' total counts the procd-service S## scripts that run after this
# bridge, so the count normally reaches it on its own at the end of boot — no
# done signal is required. As an optional failsafe (in case the count lands a
# service short), fire an event at the end of boot — add this to /etc/rc.local
# (before its `exit 0`):
#
#     ubus call service event '{"type":"boot.done","data":{}}'
#
# The bridge then finishes the moment that arrives. It does not mask the fail
# screen: a real stall never reaches rc.local, so the idle watchdog still fires.

config global 'global'
	option enabled      '1'
	option resume       '1'           # resume the initramfs-suspended splash on start
	option total        'auto'        # 'auto' = count procd-service S## scripts, or a number
	# option self_script 'splash-progress'  # our init name; set only if renamed
	option done_event   'boot.done'   # optional failsafe: ubus "service event" type = "boot done"
	option done_service 'done'        # OR a service.start name meaning "boot done"
	option idle_timeout '60'          # stall window (s) while progress is still low (0 = off)
	option idle_action  'fail'        # finished (boot settled) | fail (stalled)
	# The auto total tends to over-count by a service or two, so the count often
	# plateaus just short and the exact 100% finish never fires. Once progress
	# reaches done_at_pct, a quiet of settle_timeout counts as "boot done" (not a
	# stall) — so a normal boot finishes on its own without an rc.local hook.
	option done_at_pct  '90'          # >= this % of total = effectively complete
	option settle_timeout '5'         # quiet seconds, once near-complete, to finish

config start 'start'
	# Run once when the bridge comes up (after it resumes the splash), before the
	# first tick. Use it to set up or replace elements: drop an initramfs
	# "Preparing…" text, (re)create the progress bar, restyle the scene — so the
	# whole layout can live here instead of in the initramfs JSON. Macros read
	# 0% / count 0 of ${total}. Each entry is one object or a JSON array; omit the
	# whole section to leave the initramfs scene as-is.
	#	list start_msg '{"text":{"id":1,"remove":true}}'
	#	list start_msg '{"progress":{"id":0,"y":"80%","w":"60%","h":2,"value":"0"}}'

config progress 'progress'
	# Per-tick templates — every entry is sent on each service start. Macros are
	# global, so any works in any entry:
	#   ${value} (0..1)  ${percent} (0..100)  ${count}/${total}  ${service}
	# Each entry may be one object or a JSON array (sent as one batch).
	list   status_msg   '{"progress":{"id":0,"value":"${value}"}}'
	list   status_msg   '{"console":{"id":0,"write":"starting ${service}","color":"#9fd2ff"}}'
	# A ${percent}% readout beside a thin bar — add another entry:
	#	list status_msg '{"text":{"id":1,"text":"${percent}%"}}'
	# Auto-remove the bar when it reaches 100% (instead of removing it in the
	# finished section) — set remove_at_full on the progress element:
	#	list status_msg '{"progress":{"id":0,"value":"${value}","remove_at_full":true}}'

config finished 'finished'
	# Boot completed normally. The bar stays at 100% by default; here we just drop
	# the console and show a ready message. To make the bar vanish instead, set
	# remove_at_full on it (above) or add '{"progress":{"id":0,"remove":true}}'.
	list   done_msg     '{"console":{"id":0,"remove":true}}'
	list   done_msg     '{"text":{"id":99,"text":"System ready!","color":"#27c46b"}}'
	option delay        '0'           # hold the filled 100% frame before done_msg (debug aid)
	option hold         '2'           # seconds to show the ready frame
	option exit_action  'fade'        # none | exit | fade
	option exit_timeout '1'           # fade/exit duration in seconds
	option exit_color   '#0b0e14'

config fail 'fail'
	# Boot stalled (idle_timeout elapsed with no service activity). A distinct
	# screen — something went wrong before the done point was ever reached.
	list   fail_msg     '{"system":{"action":"clear","color":"#2a0000"}}'
	list   fail_msg     '{"text":{"id":0,"y":"40%","font":1,"size":52,"color":"#ff6060","text":"Boot stalled"}}'
	list   fail_msg     '{"text":{"id":1,"y":"56%","size":28,"color":"#ffd6d6","text":"No service activity for ${idle}s"}}'
	option hold         '15'          # show the fail screen at least this long
	option exit_action  'none'        # none keeps the screen up; exit/fade quits the daemon
	option exit_timeout '0'
	option exit_color   '#2a0000'
