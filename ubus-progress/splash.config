# Sample UCI configuration for ubus-progress — install as /etc/config/splash.
#
# It drives the elements created by examples/openwrt-boot.json: a progress bar
# (id 0), a scrolling console (id 0), and a title text (id 99). The JSON
# templates fully control which elements are touched and how, so adapt them to
# your own scene. ${value} is the 0..1 progress fraction; ${service} is the
# name of the service that just started. An empty/absent template is skipped.

config global 'global'
	option enabled      '1'
	option total        'auto'        # 'auto' = count /etc/rc.d/S*, or a number
	option done_service 'done'        # the service whose start means "boot done"

config progress 'progress'
	# Sent on every service start.
	option tick_msg     '{"progress":{"id":0,"value":"${value}"}}'
	option status_msg   '{"console":{"id":0,"write":"starting ${service}","color":"#9fd2ff"}}'

config finished 'finished'
	# Sent in order when boot completes. Here: drop the bar and console, then
	# turn the title into a "ready" message.
	list   done_msg     '{"progress":{"id":0,"remove":true}}'
	list   done_msg     '{"console":{"id":0,"remove":true}}'
	list   done_msg     '{"text":{"id":99,"text":"System ready!","color":"#27c46b"}}'
	option hold         '2'           # seconds to show the ready frame
	option exit_action  'fade'        # none | exit | fade
	option exit_timeout '1'           # fade/exit duration in seconds
	option exit_color   '#0b0e14'
